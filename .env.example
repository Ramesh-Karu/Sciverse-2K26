# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# RESEND_API_KEY: Set this in the AI Studio Secrets panel to enable real email deliveries.
# If not configured, emails will be printed to the Server Console instead for local testing.
RESEND_API_KEY=
SENDER_EMAIL=
SENDER_NAME=

# SMTP Configuration (alternative option for real email dispatch)
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=

# Firebase Configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# WhatsApp API Configuration (Meta Cloud API / Twilio / WAHA)
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# WAHA (WhatsApp HTTP API) Configuration
WAHA_API_URL="https://devlikeaprowaha-production-5bc7.up.railway.app"
WAHA_API_KEY="sha512:817eae7cef7b5dff341cc5436332236af3b02b9431cd9a68c905373a1870055a263d7fac6b0caec77a50f7665da63938f452cfc503a7ab15caee636f6443bd8e"
WAHA_SESSION="default"



