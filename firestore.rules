rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny-all catch net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "rameshnathankaruvoolan10@gmail.com" ||
        exists(/databases/$(database)/documents/admins/$(request.auth.token.email))
      );
    }

    function isSchoolCoordinator(schoolId) {
      return isSignedIn() && (
        request.auth.uid == schoolId || 
        request.auth.token.email == get(/databases/$(database)/documents/schools/$(schoolId)).data.email
      );
    }

    // --- Collection Rules ---

    // Schools Collection
    match /schools/{schoolId} {
      allow read: if true; 
      allow create: if true; 
      allow update: if true;
      allow delete: if true;
    }

    // Participants subcollection
    match /schools/{schoolId}/participants/{participantId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Solo Students
    match /soloStudents/{studentId} {
      allow read: if true;
      allow create: if true; 
      allow update, delete: if true;
    }

    // Event Days
    match /eventDays/{dayId} {
      allow read: if true;
      allow write: if true;
    }

    // Arrival Slots
    match /arrivalSlots/{slotId} {
      allow read: if true;
      allow write: if true;
    }

    // Announcements
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if true;
    }

    // Notification Logs
    match /notificationLogs/{logId} {
      allow read: if true;
      allow create: if true; 
      allow update, delete: if true;
    }

    // Admins list
    match /admins/{adminId} {
      allow read: if true;
      allow write: if true;
    }

    // Global Configs
    match /configs/{configId} {
      allow read: if true;
      allow write: if true;
    }

    // Anonymous Reviews & Feedback
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }
  }
}

