rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny-all catch net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "rameshnathankaruvoolan10@gmail.com" ||
        exists(/databases/$(database)/documents/admins/$(request.auth.token.email))
      );
    }

    function isSchoolCoordinator(schoolId) {
      return isSignedIn() && (
        request.auth.uid == schoolId || 
        request.auth.token.email == get(/databases/$(database)/documents/schools/$(schoolId)).data.email
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Validation Blueprints ---

    function isValidSchool(data) {
      return data.keys().hasAll(['name', 'principalName', 'teacherInCharge', 'contact', 'email', 'address', 'status', 'expectedStudents', 'expectedTeachers']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             data.email is string && data.email.size() > 0 && data.email.size() <= 100 &&
             data.status in ['pending', 'approved', 'rejected'];
    }

    function isValidSoloStudent(data) {
      return data.keys().hasAll(['name', 'school', 'age', 'grade', 'contact', 'email', 'address', 'parentName', 'parentContact', 'status', 'createdAt']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             data.email is string && data.email.size() > 0 && data.email.size() <= 100 &&
             data.status in ['pending', 'approved', 'rejected'];
    }

    function isValidNotificationLog(data) {
      return data.keys().hasAll(['email', 'subject', 'message', 'type', 'sentAt']) &&
             data.email is string && data.email.size() > 0 &&
             data.subject is string && data.subject.size() > 0 &&
             data.message is string && data.message.size() > 0;
    }

    // --- Collection Rules ---

    // Schools Collection
    match /schools/{schoolId} {
      allow read: if true; 
      allow create: if true; 
      allow update: if isAdmin() || isSchoolCoordinator(schoolId);
      allow delete: if isAdmin();
    }

    // Participants subcollection
    match /schools/{schoolId}/participants/{participantId} {
      allow read: if true;
      allow create, update: if isAdmin() || isSchoolCoordinator(schoolId);
      allow delete: if isAdmin() || isSchoolCoordinator(schoolId);
    }

    // Solo Students
    match /soloStudents/{studentId} {
      allow read: if true;
      allow create: if true; 
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Event Days
    match /eventDays/{dayId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Arrival Slots
    match /arrivalSlots/{slotId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Announcements
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Notification Logs
    match /notificationLogs/{logId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.email == request.auth.token.email);
      allow create: if true; 
      allow update, delete: if isAdmin();
    }

    // Admins list
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Global Configs
    match /configs/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Anonymous Reviews & Feedback
    match /reviews/{reviewId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
  }
}
